# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (your deployed frontend domain)
FRONTEND_URL=https://your-frontend-domain.com

# Amazon Product Advertising API credentials
# Get credentials from: https://affiliate-program.amazon.com/assoc_credentials/home
AMAZON_ACCESS_KEY=your_production_access_key
AMAZON_SECRET_KEY=your_production_secret_key
AMAZON_PARTNER_TAG=your_production_partner_tag
AMAZON_REGION=us-east-1
AMAZON_API_HOST=webservices.amazon.com

# Security
# Set to true to enable HTTPS redirect (when behind a proxy like nginx)
TRUST_PROXY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
